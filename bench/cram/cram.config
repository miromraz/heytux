# Kconfig fragment to enable Gregory Price's CRAM tier + the dax/kmem test
# provisioning path + a zram baseline, merged on top of a base defconfig.
# Branch: gourryinverse/linux scratch/gourry/cramtest/cram_72 (Linux 7.2.0-rc2).
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y
CONFIG_MIGRATION=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_CRAM=y
# dax / kmem / pmem provisioning (memmap=NN!SS -> dax -> kmem -> cram node)
CONFIG_LIBNVDIMM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_NVDIMM_DAX=y
# ACPI NFIT: enumerate the qemu-emulated nvdimm that stands in for the CRAM device
CONFIG_ACPI_NFIT=y
CONFIG_ACPI_HMAT=y
CONFIG_DAX=y
CONFIG_DEV_DAX=y
CONFIG_DEV_DAX_PMEM=y
CONFIG_DEV_DAX_KMEM=y
CONFIG_DEV_DAX_HMEM=y
# x86 e820-pmem backing for memmap= (nd_e820); harmless/absent on arm64
CONFIG_X86_PMEM_LEGACY=y
# zram baseline to compare the CRAM promote path against a real software codec
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_DEBUG_FS=y
