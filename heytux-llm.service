Environment=LD_LIBRARY_PATH=/home/miro/llm/root/usr/lib/aarch64-linux-gnu:/home/miro/llm/root/usr/lib/aarch64-linux-gnu/llama:/home/miro/stt/root/usr/lib/aarch64-linux-gnu
